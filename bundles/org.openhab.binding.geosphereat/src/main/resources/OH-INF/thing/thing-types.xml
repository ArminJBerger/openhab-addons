<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="geosphereat"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="weatherstation_current">
		<!-- Comment this in for Things which need a Bridge to function.
			<supported-bridge-type-refs>
			<bridge-type-ref id="geosphereATBridge" />
			</supported-bridge-type-refs>
		-->

		<label>geosphereAT Current Weather Data</label>
		<description>Connects to geosphere.at for fetching current weather data</description>

		<channels>
			<channel id="current_temperature" typeId="current_temperature"/>
			<channel id="current_humidity" typeId="current_humidity"/>
			<channel id="current_pressure" typeId="current_pressure"/>
			<channel id="current_precipitation" typeId="current_precipitation"/>
			<channel id="current_sunshine" typeId="current_sunshine"/>
		</channels>

		<config-description>
			<parameter name="refreshInterval" type="integer" unit="s" min="3600">
				<label>Refresh Interval</label>
				<description>Interval the device is polled in sec.</description>
				<default>14400</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="stationName" type="text" required="true">
				<context>weatherstationname</context>
				<label>Weather station name</label>
				<description>Name of the weatherstation in the database to use.</description>
				<default>GRAZ/STRASSGANG</default>
				<advanced>false</advanced>
			</parameter>
		</config-description>
	</thing-type>

