				<label>Refresh Interval</label>
				<description>Interval the device is polled in sec.</description>
				<default>14400</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="locationLatLon" type="text" required="true">
				<context>forecastlocation</context>
				<label>Weather forecast location</label>
				<description>Forecast location in the database to use.</description>
				<default>47.047657,15.464803</default>
				<advanced>false</advanced>
			</parameter>
		</config-description>
	</thing-type>


